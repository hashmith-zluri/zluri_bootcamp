{
  "version": 2,
  "name": "zluri-database-query-frontend",
  "buildCommand": "cd frontend && npm run build",
  "devCommand": "cd frontend && npm run dev", 
  "installCommand": "cd frontend && npm install",
  "outputDirectory": "frontend/dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}