# Server Configuration
PORT=4000
NODE_ENV=production

# Database Configuration (Neon PostgreSQL)
DB_HOST=your-neon-host
DB_PORT=5432
DB_NAME=your-database-name
DB_USER=your-username
DB_PASSWORD=your-password
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=1h

# MongoDB Atlas Configuration
ATLAS_MONGO1_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=app-name
ATLAS_MONGO1_DATABASE=your-mongo-database

# Slack Configuration
SLACK_ENABLED=true
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APPROVAL_CHANNEL=your-slack-channel-id
SLACK_ADMIN_EMAIL=your-admin-email